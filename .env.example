# Portal da Transparência API key (free; register at https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email).
# Used only at build time by src/data/bolsa-familia.parquet.py. Never exposed to the browser.
PORTAL_TRANSPARENCIA_API_KEY=

# Optional: month for Bolsa Família (YYYYMM). Defaults to three months ago.
# PORTAL_BF_MES=202606

# Optional: API requests per minute (CGU limit is ~90/min in daytime).
# PORTAL_API_RPM=80
